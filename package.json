{
  "name": "yt-downloader-electron",
  "version": "4.1.9",
  "description": "Video downloader using yt-dlp and ffmpeg",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "prestart": "node src/check-dependencies.js",
    "start": "electron .",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\"",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "postinstall": "electron-builder install-app-deps",
    "prepare-tools": "node scripts/prepare-tools.mjs",
    "build": "pnpm prepare-tools && electron-builder --publish never",
    "build:mac": "pnpm prepare-tools && electron-builder build --mac --publish never",
    "build:win": "pnpm prepare-tools && electron-builder build --win --publish never",
    "build:win:arm64": "pnpm prepare-tools && electron-builder build --win --arm64 --publish never",
    "build:linux": "pnpm prepare-tools && electron-builder build --linux AppImage --publish never",
    "build:linux:x64": "pnpm prepare-tools && electron-builder build --linux AppImage --x64 --publish never",
    "build:linux:arm64": "pnpm prepare-tools && electron-builder build --linux AppImage --arm64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shawshank01/yt-downloader-electron.git"
  },
  "keywords": [
    "youtube",
    "x(twitter)",
    "tiktok",
    "instagram",
    "facebook",
    "reddit",
    "bilibili",
    "video",
    "audio",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "electron"
  ],
  "author": {
    "name": "Michifumi",
    "email": "lelouch@outlook.ie"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Shawshank01/yt-downloader-electron/issues"
  },
  "homepage": "https://github.com/Shawshank01/yt-downloader-electron#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "overrides": {
    "@electron/rebuild": "4.0.3",
    "tar": "^7.5.11"
  },
  "build": {
    "appId": "com.ytdownloader.app",
    "productName": "YT Downloader",
    "artifactName": "YT-Downloader-${os}-${arch}-${version}.${ext}",
    "publish": {
      "provider": "github"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build-tools/${os}-${arch}",
        "to": "tools"
      }
    ],
    "files": [
      "**/*",
      "!test{,/**}",
      "!docs{,/**}",
      "!build-tools{,/**}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}
